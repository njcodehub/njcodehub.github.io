---
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'Embedded Partner',
  description:
    'De la création au débogage, je prends en charge vos systèmes embarqués pour que vos produits tiennent leurs promesses.',
};
---

<Layout metadata={metadata}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    :root {
      --bg: #0d1118;
      --bg2: #121820;
      --bg3: #171f2c;
      --card: #161d28;
      --card2: #1b2333;
      --teal: #00c8c8;
      --teal-dim: #00a0a0;
      --teal-glow: rgba(0, 200, 200, 0.12);
      --teal-border: rgba(0, 200, 200, 0.25);
      --green: #22c55e;
      --green-dark: #16a34a;
      --white: #f0f4f8;
      --muted: #a0b8cf;
      --muted2: #728fa8;
      --border: rgba(255, 255, 255, 0.07);
    }
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: 'Poppins', sans-serif;
      background: var(--bg);
      color: var(--white);
      overflow-x: hidden;
    }
    h1,
    h2,
    h3,
    h4,
    h5 {
      font-family: 'Poppins', sans-serif;
    }
    a {
      color: var(--teal);
    }
    a:hover {
      color: var(--teal-dim);
    }

    /* ─── TOP BAR (logo only, pas de menu) ─── */
    .topbar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 48px;
    }
    .brand {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 18px;
      color: var(--white);
      text-decoration: none;
      letter-spacing: -0.3px;
    }
    .brand span {
      color: var(--teal);
    }
    .topbar-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: rgba(240, 244, 248, 0.85);
    }
    .topbar-badge .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
      animation: pulse 2s infinite;
    }
    .topbar-cta {
      padding: 10px 20px;
      border-radius: 9px;
      background: linear-gradient(180deg, #00c8c8, #00a0a0);
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 0 4px 16px rgba(0, 200, 200, 0.3);
      transition: all 0.2s;
    }
    .topbar-cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(0, 200, 200, 0.42);
      color: #fff;
    }
    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.55;
      }
    }

    /* ─── URGENCY STRIP ─── */
    .urgency-strip {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 30;
      background: rgba(9, 13, 19, 0.55);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
      color: rgba(240, 244, 248, 0.9);
      text-align: center;
      font-size: 12.5px;
      font-weight: 500;
      letter-spacing: 0.2px;
      padding: 9px 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      flex-wrap: wrap;
    }
    .urgency-strip strong {
      font-weight: 700;
      color: #4ade80;
    }
    .urgency-strip svg {
      flex-shrink: 0;
      color: var(--green);
    }

    /* ─── HERO ─── */
    #hero {
      height: 100vh;
      min-height: 640px;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
    }
    .hero-media {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
    }
    .hero-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .hero-media-placeholder {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #0d1825 0%, #0a1420 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      color: #3a5060;
      font-family: monospace;
      font-size: 13px;
      text-align: center;
      line-height: 1.6;
    }
    .hero-media-placeholder::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(
        45deg,
        transparent,
        transparent 20px,
        rgba(0, 200, 200, 0.03) 20px,
        rgba(0, 200, 200, 0.03) 21px
      );
    }
    .hero-media-placeholder svg,
    .hero-media-placeholder span {
      position: relative;
      z-index: 1;
    }
    .hero-media-placeholder svg {
      opacity: 0.35;
    }
    .hero-scrim {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        90deg,
        rgba(13, 17, 24, 0.92) 0%,
        rgba(13, 17, 24, 0.78) 34%,
        rgba(13, 17, 24, 0.4) 62%,
        rgba(13, 17, 24, 0.15) 100%
      );
    }
    .hero-content {
      position: relative;
      z-index: 2;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      padding: 100px 48px 90px 80px;
      max-width: 620px;
      margin-left: 0;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 100px;
      background: rgba(0, 200, 200, 0.1);
      border: 1px solid var(--teal-border);
      font-size: 13px;
      color: var(--teal);
      margin-bottom: 26px;
      font-weight: 500;
    }
    .hero-badge::before {
      content: '';
      width: 7px;
      height: 7px;
      background: var(--teal);
      border-radius: 50%;
      animation: pulse 2s infinite;
    }
    .hero-h1 {
      font-size: clamp(40px, 4.6vw, 62px);
      font-family: 'Poppins', sans-serif;
      font-weight: 500;
      line-height: 1.18;
      letter-spacing: -1px;
      color: #fff;
      text-shadow: 0 2px 40px rgba(0, 0, 0, 0.8);
      margin-bottom: 0;
    }
    .hero-h1 .pill {
      display: inline;
      background: none;
      border: none;
      border-radius: 0;
      padding: 0;
      color: var(--teal);
      position: static;
    }
    .hero-marquee {
      margin-top: 18px;
      max-width: 460px;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
      overflow: hidden;
      padding: 4px 0;
    }
    .hero-marquee-track {
      display: flex;
      gap: 14px;
      width: max-content;
      animation: marquee 30s linear infinite;
      padding-left: 8px;
    }
    #reviews .hero-marquee-track {
      animation-duration: 40s;
    }
    .hero-marquee:hover .hero-marquee-track {
      animation-play-state: paused;
    }
    .hero-marquee .review-card {
      flex: 0 0 340px;
    }
    @keyframes marquee {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }
    .hero-review-chip {
      flex: 0 0 260px;
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(6px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      padding: 10px 14px;
      overflow: hidden;
    }
    .hero-review-chip p {
      font-size: 12.5px;
      color: rgba(240, 244, 248, 0.85);
      line-height: 1.4;
      font-style: italic;
      margin-bottom: 6px;
    }
    .hero-review-chip strong {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #fff;
    }
    .hero-review-chip span {
      font-size: 11px;
      color: rgba(240, 244, 248, 0.55);
    }
    .hero-sub {
      font-size: 17px;
      color: rgba(240, 244, 248, 0.72);
      line-height: 1.5;
      margin: 16px 0 22px;
      font-weight: 400;
      max-width: 440px;
      text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
    }
    .hero-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }
    .btn-primary {
      padding: 15px 30px;
      background: linear-gradient(180deg, #00c8c8, #00a0a0);
      color: #fff;
      border-radius: 10px;
      font-weight: 700;
      font-size: 16px;
      text-decoration: none;
      font-family: 'Poppins', sans-serif;
      transition: all 0.2s;
      box-shadow: 0 6px 22px rgba(0, 200, 200, 0.35);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: none;
      cursor: pointer;
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 32px rgba(0, 200, 200, 0.45);
      color: #fff;
    }
    .btn-ghost {
      padding: 15px 28px;
      background: transparent;
      color: var(--white);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 10px;
      font-weight: 600;
      font-size: 15px;
      text-decoration: none;
      font-family: 'Poppins', sans-serif;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-ghost:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.35);
      color: var(--white);
    }
    .hero-trust {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 22px;
    }
    .hero-avatars {
      display: flex;
    }
    .hero-avatars .av {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 2px solid #0b0f16;
      margin-left: -12px;
      background: rgba(0, 200, 200, 0.16);
      color: var(--teal);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 14px;
      overflow: hidden;
    }
    .hero-avatars .av:first-child {
      margin-left: 0;
    }
    .hero-avatars .av img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .hero-trust-text {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }
    .hero-trust-stars {
      color: var(--teal);
      font-size: 14px;
      letter-spacing: 2px;
    }
    .hero-trust-text span {
      font-size: 13px;
      color: rgba(240, 244, 248, 0.82);
    }
    .hero-trust-text span strong {
      color: var(--white);
      font-weight: 600;
    }
    .scroll-cue {
      position: absolute;
      bottom: 26px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: rgba(240, 244, 248, 0.85);
    }
    .scroll-cue span {
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.3px;
      line-height: 1.3;
    }
    .scroll-cue .scroll-circle {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      flex-shrink: 0;
      border: 2px solid var(--teal-border);
      background: rgba(0, 200, 200, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--teal);
      animation: scrollBounce 2s ease-in-out infinite;
    }
    .scroll-cue .scroll-circle svg {
      width: 26px;
      height: 26px;
    }
    @keyframes scrollBounce {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(6px);
      }
    }
    .section-cue {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--muted);
      margin: 56px auto 0;
      width: fit-content;
    }
    .section-cue span {
      font-size: 19px;
      font-weight: 500;
    }
    .section-cue .cue-circle {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1.5px solid var(--teal-border);
      background: var(--teal-glow);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--teal);
      animation: scrollBounce 2s ease-in-out infinite;
    }
    .section-cue .cue-circle svg {
      width: 18px;
      height: 18px;
    }

    /* ─── SECTION COMMON ─── */
    section {
      padding: 84px 48px;
    }
    section:not(#hero) {
      min-height: 100vh;
      display: flex;
      align-items: center;
    }
    .max-w {
      max-width: 1120px;
      margin: 0 auto;
      width: 100%;
    }
    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--teal);
      margin-bottom: 16px;
    }
    .section-label::before {
      content: '';
      display: block;
      width: 20px;
      height: 1.5px;
      background: var(--teal);
    }
    .section-title {
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 700;
      letter-spacing: -0.8px;
      line-height: 1.15;
      margin-bottom: 16px;
    }
    .section-title em {
      color: var(--teal);
      font-style: normal;
    }
    .section-sub {
      font-size: 17px;
      color: var(--muted);
      max-width: 560px;
      line-height: 1.65;
    }
    .section-header {
      margin-bottom: 44px;
    }
    .split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: center;
    }
    .split-media {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      aspect-ratio: 4/5;
      background: linear-gradient(135deg, #0d1825 0%, #0a1420 100%);
    }
    .split-media::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(
        45deg,
        transparent,
        transparent 20px,
        rgba(0, 200, 200, 0.03) 20px,
        rgba(0, 200, 200, 0.03) 21px
      );
    }
    .split-media-inner {
      position: relative;
      z-index: 1;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      color: #3a5060;
      font-family: monospace;
      font-size: 13px;
      text-align: center;
      line-height: 1.6;
      padding: 24px;
    }
    .split-media-inner svg {
      opacity: 0.35;
    }
    #solution .split-media {
      order: -1;
    }

    /* ─── PROBLÈME / AGITATION ─── */
    #problem {
      background: var(--bg2);
    }
    .problem-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 8px;
    }
    .split-text .problem-grid {
      grid-template-columns: 1fr;
    }
    .problem-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      transition: border-color 0.2s;
    }
    .problem-card:hover {
      border-color: var(--teal-border);
    }
    .problem-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ef4444;
      margin-bottom: 18px;
    }
    .problem-card h3 {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .problem-card p {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.65;
    }

    /* ─── SOLUTION / CAS D'USAGE ─── */
    #solution {
      background: var(--bg);
    }
    .uc-panels {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .split-text .uc-panels {
      grid-template-columns: 1fr;
    }
    .uc-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 24px;
      transition: border-color 0.2s;
    }
    .uc-card:hover {
      border-color: var(--teal-border);
    }
    .uc-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 600;
      color: var(--muted2);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 3px 10px;
      margin-bottom: 12px;
      letter-spacing: 0.3px;
    }
    .uc-card h3 {
      font-size: 17px;
      font-weight: 700;
      margin-bottom: 8px;
      letter-spacing: -0.2px;
    }
    .uc-card p {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.65;
    }
    .uc-card .uc-result {
      margin-top: 16px;
      padding: 10px 14px;
      border-radius: 8px;
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.25);
      font-size: 12px;
      color: #4ade80;
      font-weight: 500;
    }

    /* ─── PREUVE / PROJETS ─── */
    #proof {
      background: var(--bg2);
    }
    .projects-list {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .split-text .project-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .split-text .project-meta {
      text-align: left;
    }
    .proof-carousel {
      display: flex;
      flex-direction: column;
      gap: 12px;
      height: 100%;
    }
    .proof-carousel image-slot {
      flex: 1;
    }
    .proof-carousel-label {
      font-size: 12px;
      color: var(--muted2);
      text-align: center;
    }
    .project-row {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 30px 34px;
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 32px;
      align-items: center;
      transition: all 0.2s;
    }
    .project-row:hover {
      border-color: var(--teal-border);
      transform: translateX(4px);
    }
    .project-badge {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--muted2);
      white-space: nowrap;
    }
    .project-row h3 {
      font-size: 19px;
      font-weight: 700;
      margin-bottom: 6px;
      letter-spacing: -0.3px;
    }
    .project-row p {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.6;
    }
    .project-meta {
      text-align: right;
      white-space: nowrap;
    }
    .project-meta span {
      display: block;
      font-size: 12px;
      color: var(--muted2);
    }
    .project-meta strong {
      display: block;
      font-size: 13px;
      color: var(--teal);
      font-weight: 600;
      margin-top: 4px;
    }

    /* ─── TÉMOIGNAGES ─── */
    #reviews {
      background: var(--bg);
    }
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .review-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      transition: border-color 0.2s;
    }
    .review-card:hover {
      border-color: var(--teal-border);
    }
    .review-stars {
      display: flex;
      gap: 3px;
      margin-bottom: 14px;
      color: var(--teal);
      font-size: 14px;
    }
    .review-card blockquote {
      font-size: 14px;
      color: rgba(240, 244, 248, 0.85);
      line-height: 1.7;
      font-style: italic;
      margin-bottom: 20px;
    }
    .review-author {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .review-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--teal-glow);
      border: 1px solid var(--teal-border);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      font-size: 15px;
      font-weight: 700;
      color: var(--teal);
      font-family: 'Poppins', sans-serif;
    }
    .review-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .review-author strong {
      font-size: 14px;
      font-weight: 600;
      display: block;
    }
    .review-author span {
      font-size: 12px;
      color: var(--muted);
    }
    .review-source {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: var(--teal);
      margin-top: 14px;
      padding: 4px 10px;
      border-radius: 6px;
      border: 1px solid var(--border);
    }

    /* ─── FAQ / OBJECTIONS ─── */
    #faq {
      background: var(--bg);
    }
    .faq-list {
      display: flex;
      flex-direction: column;
      max-width: 800px;
      margin: 0 auto;
    }
    .faq-item {
      border-bottom: 1px solid var(--border);
    }
    .faq-q {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 0;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 16px;
      font-weight: 600;
      color: var(--white);
      font-family: 'Poppins', sans-serif;
      text-align: left;
      gap: 16px;
      transition: color 0.2s;
    }
    .faq-q:hover {
      color: var(--teal);
    }
    .faq-q svg {
      flex-shrink: 0;
      transition: transform 0.3s;
      color: var(--muted);
    }
    .faq-q.open svg {
      transform: rotate(180deg);
      color: var(--teal);
    }
    .faq-q.open {
      color: var(--teal);
    }
    .faq-a {
      max-height: 0;
      overflow: hidden;
      transition:
        max-height 0.35s ease,
        padding 0.2s;
    }
    .faq-a.open {
      max-height: 260px;
      padding-bottom: 20px;
    }
    .faq-a.open.faq-a-long {
      max-height: 600px;
    }
    .faq-a p {
      font-size: 15px;
      color: var(--muted);
      line-height: 1.75;
    }

    /* ─── FOOTER ─── */
    footer {
      background: #090d13;
      border-top: 1px solid var(--border);
      padding: 40px 48px 32px;
      text-align: center;
    }
    .footer-inner {
      max-width: 1120px;
      margin: 0 auto;
    }
    .footer-inner .brand {
      font-size: 16px;
    }
    .footer-inner span {
      font-size: 12px;
      color: var(--muted2);
    }
    .footer-links {
      display: flex;
      gap: 18px;
      justify-content: center;
    }
    .footer-links a {
      font-size: 12px;
      color: var(--muted);
      text-decoration: none;
    }
    .footer-links a:hover {
      color: var(--white);
    }

