---
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'Réserver un appel — Embedded Partner',
};
---

<Layout metadata={metadata}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
<script is:inline src="https://assets.calendly.com/assets/external/widget.js"></script>
<style is:global>
  :root{--bg:#0d1118;--bg2:#121820;--card:#161d28;--teal:#00c8c8;--teal-border:rgba(0,200,200,0.25);--teal-glow:rgba(0,200,200,0.12);--white:#f0f4f8;--muted:#a0b8cf;--muted2:#728fa8;--border:rgba(255,255,255,0.07);--green:#22c55e}
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Poppins',sans-serif;background:radial-gradient(ellipse at top,rgba(0,200,200,0.08),transparent 60%),var(--bg);color:var(--white);min-height:100vh;display:flex;flex-direction:column}
  a{color:var(--teal)}
  a:hover{color:#00a0a0}
  .topbar{display:flex;align-items:center;justify-content:space-between;padding:22px 48px}
  .brand{font-weight:600;font-size:18px;color:var(--white);text-decoration:none;letter-spacing:-0.3px}
  .brand span{color:var(--teal)}
  main{flex:1;display:flex;align-items:center;justify-content:center;padding:40px 24px}
  .booking-card{max-width:560px;text-align:center}
  .badge{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:100px;background:rgba(0,200,200,0.1);border:1px solid var(--teal-border);font-size:13px;color:var(--teal);margin-bottom:22px;font-weight:500}
  .badge::before{content:'';width:7px;height:7px;background:var(--teal);border-radius:50%}
  h1{font-size:clamp(28px,3.6vw,42px);font-weight:700;letter-spacing:-0.8px;line-height:1.15;margin-bottom:16px}
  h1 em{color:var(--teal);font-style:normal}
  .sub{font-size:16px;color:var(--muted);line-height:1.65;max-width:440px;margin:0 auto 36px}
  .book-btn{display:inline-flex;align-items:center;gap:10px;padding:17px 34px;background:linear-gradient(180deg,#00c8c8,#00a0a0);color:#fff;border:none;border-radius:10px;font-weight:700;font-size:16px;font-family:'Poppins',sans-serif;cursor:pointer;box-shadow:0 6px 22px rgba(0,200,200,0.35);transition:all 0.2s}
  .book-btn:hover{transform:translateY(-2px);box-shadow:0 10px 32px rgba(0,200,200,0.45);color:#fff}
  .reassurance{margin-top:28px;display:flex;flex-direction:column;gap:10px;align-items:flex-start;max-width:360px;margin-left:auto;margin-right:auto}
  .reassurance div{display:flex;align-items:center;gap:10px;font-size:13px;color:rgba(240,244,248,0.72)}
  .reassurance svg{color:var(--green);flex-shrink:0}
  footer{padding:24px 48px;text-align:center;font-size:12px;color:var(--muted2)}
  @media (max-width:600px){.topbar{padding:18px 22px}}
</style>
<div class="topbar">
  <a href="/" class="brand">Embedded<span>Partner</span></a>
</div>
<main>
  <div class="booking-card">
    <div class="badge">Étape suivante</div>
    <h1>Réservez votre appel <em>gratuit</em> de 30 minutes</h1>
    <p class="sub">Choisissez le créneau qui vous arrange. On analyse votre situation ensemble, sans engagement.</p>
    <!-- ▼ Remplacer YOUR_CALENDLY_LINK par votre lien Calendly (ex: https://calendly.com/votrenom/30min) -->
    <button class="book-btn" onclick="Calendly.initPopupWidget({url:'https://calendly.com/YOUR_CALENDLY_LINK'});return false;">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      Choisir mon créneau
    </button>
    <div class="reassurance">
      <div><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>Zéro engagement</div>
      <div><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>NDA signé avant tout échange</div>
    </div>
  </div>
</main>
<footer>© 2026 Embedded Partner — Noëlie Jestin · Paris &amp; remote</footer>
</Layout>
